<launch>
  <arg name="exp_param_file" value="$(find remani_planner)/config/exp_charging_param.yaml"/>
  <arg name="init_x" default="-3.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>
  <arg name="init_j1" default="0.0"/>
  <arg name="init_j2" default="60.0"/>
  <arg name="init_j3" default="-120.0"/>
  <arg name="init_j4" default="0.0"/>
  <arg name="init_j5" default="0.0"/>
  <arg name="init_j6" default="0.0"/>
  <arg name="show_rviz" default="true"/>
  <arg name="affordance_duration" default="45.0"/>
  <arg name="arm_blend_duration" default="3.0"/>
  <arg name="arm_sync_threshold" default="0.08"/>
  <arg name="arm_wait_for_sync" default="false"/>
  <arg name="retrigger_on_stage" default="false"/>

  <include file="$(find remani_planner)/launch/run_in_sim_staged.launch">
    <arg name="exp_param_file" value="$(arg exp_param_file)"/>
    <arg name="generate_map_size_x" value="8"/>
    <arg name="generate_map_size_y" value="5"/>
    <arg name="generate_map_size_z" value="3"/>
    <arg name="map_resolution" value="0.10"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_yaw" value="$(arg init_yaw)"/>
    <arg name="init_j1" value="$(arg init_j1)"/>
    <arg name="init_j2" value="$(arg init_j2)"/>
    <arg name="init_j3" value="$(arg init_j3)"/>
    <arg name="init_j4" value="$(arg init_j4)"/>
    <arg name="init_j5" value="$(arg init_j5)"/>
    <arg name="init_j6" value="$(arg init_j6)"/>
    <arg name="arm_blend_duration" value="$(arg arm_blend_duration)"/>
    <arg name="arm_sync_threshold" value="$(arg arm_sync_threshold)"/>
    <arg name="arm_wait_for_sync" value="$(arg arm_wait_for_sync)"/>
  </include>

  <node name="charging_demo_helper" pkg="remani_planner" type="charging_demo_helper" output="screen">
    <rosparam file="$(arg exp_param_file)"/>
    <rosparam param="fsm/init_state" subst_value="true">[$(arg init_x), $(arg init_y), $(arg init_j1), $(arg init_j2), $(arg init_j3), $(arg init_j4), $(arg init_j5), $(arg init_j6)]</rosparam>
    <param name="fsm/init_yaw" value="$(arg init_yaw)"/>
  </node>

  <node name="arm_affordance_monitor" pkg="remani_planner" type="arm_affordance_monitor.py" output="screen">
    <param name="run_name" value="staged"/>
    <param name="duration" value="$(arg affordance_duration)"/>
    <param name="rate" value="1.0"/>
    <param name="seed_count" value="16"/>
    <param name="switch_s" value="0.55"/>
    <param name="switch_reachability" value="0.8"/>
    <param name="switch_clearance" value="0.03"/>
    <param name="switch_manipulability" value="0.15"/>
    <param name="switch_hold" value="1"/>
    <param name="publish_marker" value="true"/>
    <param name="retrigger_target" value="$(arg retrigger_on_stage)"/>
  </node>

  <node if="$(arg show_rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find remani_planner)/launch/exp_charging.rviz"/>
</launch>
