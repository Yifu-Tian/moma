<launch>
	<arg name="map_size_x_"/>
	<arg name="map_size_y_"/>
	<arg name="map_size_z_"/>

	<arg name="odometry_topic"/>
	<arg name="joint_state_topic"/>
	<arg name="gripper_state_topic"/>
	<arg name="joint_cmd_topic"/>
	<arg name="gripper_cmd_topic"/>
	<arg name="camera_pose_topic"/>
	<arg name="depth_topic"/>
	<arg name="cloud_topic"/>
	<arg name="exp_param_file"/>

	<arg name="cx"/>
	<arg name="cy"/>
	<arg name="fx"/>
	<arg name="fy"/>
	<arg name="enable_diffusion_arm_planner" default="false"/>
	<arg name="diffusion_service_name" default="/diffusion_arm_planner/plan"/>
	<arg name="init_x"/>
	<arg name="init_y"/>
	<arg name="init_yaw"/>
	<arg name="init_j1"/>
	<arg name="init_j2"/>
	<arg name="init_j3"/>
	<arg name="init_j4"/>
	<arg name="init_j5"/>
	<arg name="init_j6"/>
	<arg name="arm_activation_enabled" default="true"/>
	<arg name="manipulator_safe_collision_check" default="false"/>
	<arg name="weight_arm_activation" default="0.8"/>
	<arg name="weight_arm_activation_vel" default="0.05"/>
	<arg name="arm_activation_full_dist" default="1.20"/>
	<arg name="arm_activation_release_dist" default="0.35"/>
	<arg name="arm_activation_clearance_dist" default="0.55"/>
	<arg name="arm_activation_clearance_release_dist" default="0.25"/>
	<arg name="arm_activation_collision_skip_weight" default="1.10"/>
	<arg name="base_motion_regularization_enabled" default="false"/>
	<arg name="weight_base_progress" default="25.0"/>
	<arg name="base_progress_margin" default="0.05"/>
	<arg name="weight_base_yaw_rate" default="0.0"/>
	<arg name="weight_base_yaw_acc" default="0.0"/>
	<arg name="flexible_goal_enabled" default="true"/>
	<arg name="ik_goal_enabled" default="true"/>
	<arg name="min_approach_standoff" default="0.02"/>
	<arg name="flexible_goal_yaw_range" default="0.52"/>
	<arg name="flexible_goal_yaw_samples" default="13"/>
	<arg name="flexible_goal_yaw_weight" default="0.15"/>
	<arg name="random_seed" default="2"/>
	<arg name="try_astar_times" default="10"/>
	<arg name="max_seach_time" default="0.5"/>
	<arg name="base_only_frontend_enabled" default="true"/>
	<arg name="base_only_release_dist" default="1.20"/>
	<arg name="base_only_check_dt" default="0.05"/>
	<arg name="base_only_max_arm_delta" default="10.0"/>
  
  <!-- main node -->
  	<node pkg="remani_planner" name="remani_planner_node" type="remani_planner_node" output="screen">
		<rosparam file="$(find remani_planner)/config/mm_param.yaml"/>
		<rosparam file="$(find remani_planner)/config/remani_planner_param.yaml"/>
		<rosparam file="$(arg exp_param_file)"/>
		<rosparam param="fsm/init_state" subst_value="true">[$(arg init_x), $(arg init_y), $(arg init_j1), $(arg init_j2), $(arg init_j3), $(arg init_j4), $(arg init_j5), $(arg init_j6)]</rosparam>
		<param name="fsm/init_yaw" value="$(arg init_yaw)"/>
		<param name="optimization/arm_activation_enabled" value="$(arg arm_activation_enabled)"/>
		<param name="optimization/manipulator_safe_collision_check" value="$(arg manipulator_safe_collision_check)"/>
		<param name="optimization/weight_arm_activation" value="$(arg weight_arm_activation)"/>
		<param name="optimization/weight_arm_activation_vel" value="$(arg weight_arm_activation_vel)"/>
		<param name="optimization/arm_activation_full_dist" value="$(arg arm_activation_full_dist)"/>
		<param name="optimization/arm_activation_release_dist" value="$(arg arm_activation_release_dist)"/>
		<param name="optimization/arm_activation_clearance_dist" value="$(arg arm_activation_clearance_dist)"/>
		<param name="optimization/arm_activation_clearance_release_dist" value="$(arg arm_activation_clearance_release_dist)"/>
		<param name="optimization/arm_activation_collision_skip_weight" value="$(arg arm_activation_collision_skip_weight)"/>
		<param name="optimization/base_motion_regularization_enabled" value="$(arg base_motion_regularization_enabled)"/>
		<param name="optimization/weight_base_progress" value="$(arg weight_base_progress)"/>
		<param name="optimization/base_progress_margin" value="$(arg base_progress_margin)"/>
		<param name="optimization/weight_base_yaw_rate" value="$(arg weight_base_yaw_rate)"/>
		<param name="optimization/weight_base_yaw_acc" value="$(arg weight_base_yaw_acc)"/>
		<param name="charging_demo/flexible_goal_enabled" value="$(arg flexible_goal_enabled)"/>
		<param name="charging_demo/ik_goal_enabled" value="$(arg ik_goal_enabled)"/>
		<param name="charging_demo/min_approach_standoff" value="$(arg min_approach_standoff)"/>
		<param name="charging_demo/flexible_goal_yaw_range" value="$(arg flexible_goal_yaw_range)"/>
		<param name="charging_demo/flexible_goal_yaw_samples" value="$(arg flexible_goal_yaw_samples)"/>
		<param name="charging_demo/flexible_goal_yaw_weight" value="$(arg flexible_goal_yaw_weight)"/>
		<param name="search/random_seed" value="$(arg random_seed)"/>
		<param name="search/try_astar_times" value="$(arg try_astar_times)"/>
		<param name="search/max_seach_time" value="$(arg max_seach_time)"/>
		<param name="search/base_only_frontend_enabled" value="$(arg base_only_frontend_enabled)"/>
		<param name="search/base_only_release_dist" value="$(arg base_only_release_dist)"/>
		<param name="search/base_only_check_dt" value="$(arg base_only_check_dt)"/>
		<param name="search/base_only_max_arm_delta" value="$(arg base_only_max_arm_delta)"/>

		<remap from="~gripper_cmd" to="$(arg gripper_cmd_topic)"/>
		<remap from="~gripper_state" to="$(arg gripper_state_topic)"/>
  
		<remap from="~odom_world" to="$(arg odometry_topic)"/>
		<remap from="~joint_state" to="$(arg joint_state_topic)"/>
		<remap from="~planning/trajectory" to = "planning/trajectory"/>
		<remap from="~planning/start" to = "planning/start"/>
		<remap from="~planning/finish" to = "planning/finish"/>
		<remap from="~planning/data_display" to = "planning/data_display"/>

		<remap from="~grid_map/odom"  to="$(arg odometry_topic)"/>
		<remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
		<remap from="~grid_map/pose"  to = "$(arg camera_pose_topic)"/> 
		<remap from="~grid_map/depth" to = "$(arg depth_topic)"/>
		
		<!-- planning fsm -->
		<param name="fsm/thresh_no_replan_meter"  value="2.5" type="double"/>
		<param name="fsm/fail_safe"               value="true"/>
		
		<param name="grid_map/resolution"             value="0.05" /> 
		<param name="grid_map/map_size_x"             value="$(arg map_size_x_)" /> 
		<param name="grid_map/map_size_y"             value="$(arg map_size_y_)" /> 
		<param name="grid_map/map_size_z"             value="$(arg map_size_z_)" /> 
		<param name="grid_map/local_update_range_x"   value="17" /> 
		<param name="grid_map/local_update_range_y"   value="17" /> 
		<param name="grid_map/local_update_range_z"   value="3.0" /> 
		<param name="grid_map/obstacles_inflation"    value="0.00" /> 
		<param name="grid_map/local_map_margin"       value="15"/>
		<param name="grid_map/ground_height"          value="-0.01"/>
		<param name="grid_map/z_length"               value="0.0"/>
		<!-- camera parameter -->
		<param name="grid_map/cx" value="$(arg cx)"/>
		<param name="grid_map/cy" value="$(arg cy)"/>
		<param name="grid_map/fx" value="$(arg fx)"/>
		<param name="grid_map/fy" value="$(arg fy)"/>
		<!-- depth filter -->
		<param name="grid_map/use_depth_filter"       value="true"/>
		<param name="grid_map/depth_filter_tolerance" value="0.15"/>
		<param name="grid_map/depth_filter_maxdist"   value="5.0"/>
		<param name="grid_map/depth_filter_mindist"   value="0.2"/>
		<param name="grid_map/depth_filter_margin"    value="2"/>
		<param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
		<param name="grid_map/skip_pixel"             value="2"/>
		<!-- local fusion -->
		<param name="grid_map/p_hit"  value="0.65"/>
		<param name="grid_map/p_miss" value="0.35"/>
		<param name="grid_map/p_min"  value="0.12"/>
		<param name="grid_map/p_max"  value="0.90"/>
		<param name="grid_map/p_occ"  value="0.80"/>
		<param name="grid_map/min_ray_length" value="0.1"/>
		<param name="grid_map/max_ray_length" value="4.5"/>
	
		<param name="grid_map/virtual_ceil_height"              value="4.0"/>
		<param name="grid_map/visualization_truncate_height"    value="2.8"/>
		<param name="grid_map/show_occ_time"                    value="false"/>
		<param name="grid_map/pose_type"                        value="1"/>  
		<param name="grid_map/frame_id"                         value="world"/>

		<!-- sdf map -->
		<param name="grid_map/local_bound_inflate"              value="0.0"/>
		<param name="grid_map/show_esdf_time"                   value="false"/>
		<param name="grid_map/esdf_slice_height"                value="-0.1"/>

		<!-- planner manager -->
		<param name="manager/control_points_distance"           value="0.4" type="double"/>
		<param name="manager/polyTraj_piece_length"             value="2.0" type="double"/>
		<param name="manager/feasibility_tolerance"             value="0.05" type="double"/>
		<param name="diffusion/enable_arm_prior"                value="$(arg enable_diffusion_arm_planner)"/>
		<param name="diffusion/service_name"                    value="$(arg diffusion_service_name)"/>
  	</node>

	<node pkg="mm_controller" name="mm_controller_node" type="mm_controller_node" output="screen">
		<rosparam file="$(find remani_planner)/config/mm_param.yaml"/>
		<rosparam file="$(find remani_planner)/config/remani_planner_param.yaml"/>
		<rosparam file="$(arg exp_param_file)"/>
		<rosparam param="fsm/init_state" subst_value="true">[$(arg init_x), $(arg init_y), $(arg init_j1), $(arg init_j2), $(arg init_j3), $(arg init_j4), $(arg init_j5), $(arg init_j6)]</rosparam>
		<param name="fsm/init_yaw" value="$(arg init_yaw)"/>
  
		<remap from="~odom" to="$(arg odometry_topic)"/>
		<remap from="~joint_states" to="$(arg joint_state_topic)"/>
		<remap from="~joint_cmd" to="$(arg joint_cmd_topic)"/>
		<remap from="~planning/trajectory" to = "planning/trajectory"/>
		<remap from="~planning/start" to = "planning/start"/>
		<remap from="~planning/finish" to = "planning/finish"/>
  	</node>

	<group if="$(arg enable_diffusion_arm_planner)">
		<node pkg="diffusion_arm_planner" name="diffusion_arm_planner" type="diffusion_arm_planner_node.py" output="screen">
			<param name="service_name" value="$(arg diffusion_service_name)"/>
		</node>
	</group>

</launch>
