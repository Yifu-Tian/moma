<?xml version="1.0"?>
<robot name="mobile_piper_robot">

  <!-- ========================= -->
  <!-- 底盘 -->
  <!-- ========================= -->
  <link name="mobile_base">
    <inertial>
      <origin
        xyz="0.24 0.17 0"
        rpy="1.57 0 -1.57" />
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
    <visual>
      <origin
        xyz="0.24 0.17 0"
        rpy="1.57 0 -1.57" />
      <geometry>
        <mesh filename="package://mm_config/meshes/MOMA/FW-mini.STL"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0.24 0.17 0"
        rpy="1.57 0 -1.57" />
      <geometry>
        <mesh filename="package://mm_config/meshes/MOMA/FW-mini.STL"/>
      </geometry>
    </collision>
  </link>
  <!-- ========================= -->
  <!-- 虚拟移动底盘 -->
  <!-- ========================= -->
  <link name="world"/>
  <link name="virtual0"/>

  <link name="virtual1"/>
  <link name="virtual2"/>

  <joint name="world_to_virtual0" type="fixed">
    <parent link="world"/>
    <child link="virtual0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

   <!-- 虚拟 prismatic x -->
  <joint name="virtual_joint1" type="prismatic">
    <parent link="virtual0"/>
    <child link="virtual1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-999999" upper="999999" velocity="4.0"/>
  </joint>

  <!-- virtual prismatic y -->
  <joint name="virtual_joint2" type="prismatic">
    <parent link="virtual1"/>
    <child link="virtual2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-999999" upper="999999" velocity="4.0"/>
  </joint>

  <!-- virtual yaw -->
  <joint name="virtual_joint3" type="revolute">
    <parent link="virtual2"/>
    <child link="mobile_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="-999999" upper="999999" velocity="4.0"/>
  </joint>
  <!-- ========================= -->
  <!-- 铝型材长方体 -->
  <!-- ========================= -->
  <link name="aluminum_connector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.3 0.135"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.3 0.135"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- 连接底盘 → 铝型材 -->
  <!-- ========================= -->
  <joint name="base_to_aluminum" type="fixed">
    <parent link="mobile_base"/>
    <child link="aluminum_connector"/>
    <origin xyz="0.145 0 0.3675" rpy="0 0 0"/> <!-- 调整铝型材底部高度 -->
  </joint>

  <!-- ========================= -->
  <!-- Piper 机械臂底座 (dummy_link) -->
  <!-- 这里假设你已经有 Piper 的 URDF 内容 -->
  <!-- ========================= -->

  <!-- 铝型材 → Piper 底座 -->

  <joint name="aluminum_to_arm" type="fixed">
    <parent link="aluminum_connector"/>
    <child link="dummy_link"/> 
    <origin xyz="0.005 0 0.0675" rpy="0 0 0"/> 
  </joint>


  <!-- ========================= -->
  <!-- 将 Piper URDF 内容插入这里 -->
  <!-- 从 dummy_link 开始，包含所有 link 和 joint -->
  <!-- 你可以直接把 Piper 的 URDF 剪切到这里 -->
  <!-- ========================= -->
  <link name="dummy_link"/>
  <joint name="base_to_dummy" type="fixed">
    <parent link="dummy_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link
    name="base_link">
    <inertial>
